#env
.env
.env.*

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

node_modules
dist
dist-ssr
*.local

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

.env
# Large frame sequence
public/sequence/

# Video files — too large for GitHub free tier; host on CDN separately
public/videos/
*.mp4
*.MP4
*.mov
*.MOV

# Keep lightweight website preview posters in source control.
!public/videos/
public/videos/*
!public/videos/websites/
public/videos/websites/*
!public/videos/websites/posters/
public/videos/websites/posters/*
!public/videos/websites/posters/*.jpg
!public/videos/websites/posters/*.webp

# Brand clips are shipped as .webm: 5-9 MB each, against 144-175 MB for the
# .mp4 masters beside them. The masters stay out (see *.mp4 above); these are
# the versions the site actually serves.
!public/brands/**/*.webm

# Web-encoded H.264 derivatives (720p/CRF26, "-web.mp4"). Needed because Safari
# support for WebM is patchy, so the homepage commercials ship as mp4. Small
# enough to track; the multi-hundred-MB masters they came from are not.
!public/brands/**/*-web.mp4

# Local utility scripts
copy_brands.ps1
copy_anims.ps1
check_sizes.ps1

.vercel

# Interior Design project films are web-encoded (5.8-19.7 MB) and shipped;
# the multi-hundred-MB masters remain in their source projects, not here.
!public/interior-design/**/*.mp4
